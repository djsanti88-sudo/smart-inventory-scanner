{
  "name": "inventory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-jwks-rsa.cjs",
    "teach": "node e2e/teach/teach.mjs",
    "teach:cleanup": "node e2e/teach/cleanup.mjs",
    "teach:regression": "playwright test --config=playwright.teach.config.ts",
    "teach:test": "node --test \"e2e/teach/**/*.test.mjs\"",
    "teach:bugreport": "node e2e/teach/bugReport.mjs",
    "teach:bugreport:pdf": "node e2e/teach/pdfReport.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:emulator": "node scripts/dev.mjs --emulator",
    "dev:prod": "node scripts/dev.mjs --prod",
    "demo:local": "node scripts/local-demo.mjs",
    "demo:provision": "node scripts/provision-worktree.mjs",
    "demo:manifest": "node scripts/tire-demo-proof/generate-manifest.mjs",
    "demo:proof:summary": "node scripts/tire-demo-proof/summarize.mjs",
    "build": "next build",
    "build:knowledge-db": "node --max-old-space-size=4096 scripts/build-knowledge-db.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:parallel && npm run test:perf:serial && npm run test:identity-apply-perf",
    "test:parallel": "vitest run --config vitest.parallel.config.ts",
    "test:ci:parallel": "vitest run --config vitest.ci.parallel.config.ts",
    "test:no-browser:parallel": "vitest run --config vitest.no-browser.parallel.config.ts",
    "test:perf:serial": "vitest run src/services/import/importPerf.test.ts src/server/identity/atomicLocalStorage.test.ts src/server/identity/localIdentityReadModel.test.ts src/server/identity/readOnlyCandidateSource.test.ts src/eval/identity/importPerf.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "test:golden": "vitest run src/eval/goldenBaseline.test.ts",
    "test:corpus-drift": "vitest run src/server/tire-knowledge/corpusDrift.test.ts",
    "test:refresh-tire-meta": "node --test scripts/refresh-tire-meta.test.mjs",
    "test:local-demo": "node --test scripts/local-demo.test.mjs scripts/local-demo-egress-guard.test.mjs scripts/local-demo-environment.test.mjs scripts/local-demo-preflight.test.mjs scripts/local-demo-sampler.test.mjs && vitest run src/app/api/ai-lookup/route.localDemo.test.ts src/server/decode/pipeline.localDemo.test.ts src/server/tire-knowledge/localDemoTrust.test.ts src/server/tire-knowledge/tireKnowledgeIndex.localDemo.test.ts src/server/localDemo.test.ts src/server/localDemoRouteGuards.test.ts src/server/proxy.localDemo.test.ts src/services/reports/localDemoLedgerProof.test.ts src/services/security/localDemoClientEgress.test.ts src/stores/localDemoBatch01Suggested.repro.test.ts src/stores/localDemoCanonicalIdentity.test.ts src/stores/scanStore.localDemoPersistence.test.ts src/components/SpeedInsightsTelemetry.test.tsx",
    "test:local-demo-egress": "node --test scripts/local-demo-egress-guard.test.mjs scripts/local-demo.test.mjs && vitest run src/services/security/localDemoClientEgress.test.ts src/components/SpeedInsightsTelemetry.test.tsx",
    "test:tire-demo-proof": "node --test scripts/tire-demo-proof/generate-manifest.test.mjs scripts/tire-demo-proof/summarize.test.mjs scripts/tire-demo-proof/validate-result.test.mjs",
    "test:identity-apply-perf": "vitest run src/eval/identity/applyPerf.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:ledger": "vitest run src/stores/ledgerInvariants.store.test.ts src/stores/unknownEnqueue.store.test.ts src/stores/mergeUnion.store.test.ts src/stores/markWrongTransfer.store.test.ts src/stores/provenanceTier.store.test.ts src/stores/goldenClasses.store.test.ts src/services/inventory.replay.test.ts src/server/upc/ladderTimeout.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:ct": "playwright test --config=playwright-ct.config.ts",
    "release:check": "node scripts/release-sentinel.mjs",
    "proof:local": "tsc --noEmit && npm test",
    "proof:full": "npm run proof:local && next build",
    "deploy:card": "node scripts/release-sentinel.mjs --deploy-card",
    "live-decode-smoke": "node scripts/live-decode-smoke.ts",
    "eval-decode": "node scripts/eval-decode.ts",
    "build:tire-knowledge": "node scripts/build-tire-knowledge.mjs",
    "eval-decode:corpus": "node scripts/eval-decode.ts --corpus",
    "benchmark": "node scripts/benchmark-decodes.ts",
    "emulators": "firebase emulators:start --project demo-smart-inventory --only auth,firestore",
    "deploy:rules:prod": "firebase deploy --only firestore:rules,firestore:indexes --project smart-inventory-scanner-app",
    "test:firebase": "firebase emulators:exec --project demo-smart-inventory --only auth,firestore \"vitest run src/services/db/firebase\"",
    "test:e2e:firebase": "firebase emulators:exec --project demo-smart-inventory --only auth,firestore \"playwright test --config=playwright.firebase.config.ts\"",
    "test:firebase:cloud-smoke": "node scripts/cloud-smoke.mjs",
    "qa:bots": "playwright test --config=playwright.bots.config.ts",
    "qa:bots:tire": "playwright test --config=playwright.bots.config.ts platformOwner-tire-resolution",
    "qa:bots:security": "playwright test --config=playwright.bots.config.ts role-security-leak export-leak",
    "qa:bots:ux": "playwright test --config=playwright.bots.config.ts ux-no-training",
    "qa:bots:manager": "playwright test --config=playwright.bots.config.ts manager-workflow",
    "qa:bots:data": "playwright test --config=playwright.bots.config.ts data-integrity",
    "qa:bots:performance": "playwright test --config=playwright.bots.config.ts performance-smoke",
    "qa:bots:all": "playwright test --config=playwright.bots.config.ts",
    "qa:bots:live": "playwright test --config=playwright.bots.cloud.config.ts",
    "qa:revision": "npx tsc --noEmit && npx eslint src e2e && npx next build && npx playwright test && npm run test:firebase && npm run test:corpus-drift && npm run qa:bots",
    "qa:weekly-report": "npm run qa:bots:security && npm run qa:bots:data && npm run qa:bots:tire && npm run qa:bots:ux",
    "weekly-report": "node scripts/weekly-report.mjs",
    "intel:now": "node scripts/weekly-intel.mjs",
    "intel:tire-scan": "node scripts/weekly-tire-scan.ts",
    "intel:report": "node scripts/build-report-html.mjs",
    "intel:validate": "node scripts/validate-agents.mjs",
    "harvest": "node scripts/barcode-harvester/engine.mjs",
    "harvest:discount-tire": "node scripts/barcode-harvester/engine.mjs --site discount-tire",
    "harvest:test": "node scripts/barcode-harvester/engine.mjs --site discount-tire --max-pages 5 --headless false"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/speed-insights": "^2.0.0",
    "barcode-detector": "^3.2.1",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/cli": "^0.1.17",
    "@playwright/experimental-ct-react": "^1.61.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
