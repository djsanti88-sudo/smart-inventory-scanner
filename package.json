{
  "name": "inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-jwks-rsa.cjs",
    "dev": "node scripts/dev.mjs",
    "dev:emulator": "node scripts/dev.mjs --emulator",
    "dev:prod": "node scripts/dev.mjs --prod",
    "build": "next build",
    "build:knowledge-db": "node --max-old-space-size=4096 scripts/build-knowledge-db.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run src/eval/goldenBaseline.test.ts",
    "test:corpus-drift": "vitest run src/server/tire-knowledge/corpusDrift.test.ts",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release-sentinel.mjs",
    "proof:local": "tsc --noEmit && vitest run",
    "proof:full": "npm run proof:local && next build",
    "deploy:card": "node scripts/release-sentinel.mjs --deploy-card",
    "live-decode-smoke": "node scripts/live-decode-smoke.ts",
    "eval-decode": "node scripts/eval-decode.ts",
    "build:tire-knowledge": "node scripts/build-tire-knowledge.mjs",
    "eval-decode:corpus": "node scripts/eval-decode.ts --corpus",
    "benchmark": "node scripts/benchmark-decodes.ts",
    "emulators": "firebase emulators:start --project demo-smart-inventory --only auth,firestore",
    "test:firebase": "firebase emulators:exec --project demo-smart-inventory --only firestore \"vitest run src/services/db/firebase\"",
    "test:e2e:firebase": "firebase emulators:exec --project demo-smart-inventory --only auth,firestore \"playwright test --config=playwright.firebase.config.ts\"",
    "test:firebase:cloud-smoke": "node scripts/cloud-smoke.mjs",
    "qa:bots": "playwright test --config=playwright.bots.config.ts",
    "qa:bots:tire": "playwright test --config=playwright.bots.config.ts platformOwner-tire-resolution",
    "qa:bots:security": "playwright test --config=playwright.bots.config.ts role-security-leak export-leak",
    "qa:bots:ux": "playwright test --config=playwright.bots.config.ts ux-no-training",
    "qa:bots:manager": "playwright test --config=playwright.bots.config.ts manager-workflow",
    "qa:bots:data": "playwright test --config=playwright.bots.config.ts data-integrity",
    "qa:bots:performance": "playwright test --config=playwright.bots.config.ts performance-smoke",
    "qa:bots:all": "playwright test --config=playwright.bots.config.ts",
    "qa:bots:live": "playwright test --config=playwright.bots.cloud.config.ts",
    "qa:revision": "npx tsc --noEmit && npx eslint src e2e && npx next build && npx playwright test && npm run test:firebase && npm run qa:bots",
    "qa:weekly-report": "npm run qa:bots:security && npm run qa:bots:data && npm run qa:bots:tire && npm run qa:bots:ux",
    "weekly-report": "node scripts/weekly-report.mjs",
    "intel:now": "node scripts/weekly-intel.mjs",
    "intel:tire-scan": "node scripts/weekly-tire-scan.ts",
    "intel:report": "node scripts/build-report-html.mjs",
    "intel:validate": "node scripts/validate-agents.mjs",
    "harvest": "node scripts/barcode-harvester/engine.mjs",
    "harvest:discount-tire": "node scripts/barcode-harvester/engine.mjs --site discount-tire",
    "harvest:test": "node scripts/barcode-harvester/engine.mjs --site discount-tire --max-pages 5 --headless false"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "barcode-detector": "^3.2.1",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
