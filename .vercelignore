# Harvest data + outputs are NOT part of the Next.js app — the deployed app reads the cloud catalog
# (Firestore) at runtime, never these local files. Excluding them keeps deploys under the 100MB limit.
data/
e2e/proof/
e2e/test-results/
playwright-report/
*.csv.gz
*.jsonl

# Big local-only corpus artifacts (2026-07-09): retail + tire corpora now live in Turso and are read
# at runtime via the Turso client, not from these files. Excluding them fixes the "File size limit
# exceeded (100 MB)" failed deploy (860MB upload, incl. a 343MB SQLite .db). Local dev still builds
# and reads these files directly (fs, not a static import) — see src/decoding/server/knowledge/knowledgeDb.ts and
# src/decoding/server/knowledge/tire/tireKnowledgeIndex.ts. Keep the small .meta.json (diagnostics only).
src/decoding/server/knowledge/knowledge.generated.db
src/decoding/server/knowledge/knowledge.generated.db.gz
src/decoding/server/knowledge/retail/retailKnowledge.generated.json
src/decoding/server/knowledge/tire/tireKnowledge.generated.json
src/decoding/server/knowledge/tire/tireKnowledge.generated.json.bak-*
