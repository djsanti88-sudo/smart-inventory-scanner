{
  // High-churn dirs written every 1-2s by the dt-harvest crawl fleet and agent
  // tooling. Without these excludes the VS Code file watcher + git extension
  // rescan on every write, which freezes the renderer ("window is not
  // responding") during long harvest/agent sessions (seen 2026-07-09).
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/scripts/dt-harvest/state/**": true,
    "**/.superpowers/**": true,
    "**/e2e/proof/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/data/**": true,
    "**/.serena/**": true,
    "**/*.jsonl": true,
    "**/.ai-lookup-usage.json": true,
    "**/.gpt-ladder-usage.json": true,
    "**/.go-upc-usage.json": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/scripts/dt-harvest/state": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/data": true
  },
  "files.exclude": {
    "/.git": true,
    "/.next": true,
    "/node_modules": true,
    "/data": true,
    "/reports": true,
    "/outputs": true,
    "**/.git": true,
    "**/.next": true,
    "**/node_modules": true,
    "**/data": true,
    "**/reports": true,
    "**/outputs": true,
    "**/e2e/proof": true,
    "**/testing/artifacts": true,
    "**/.playwright-*": true,
    "**/.superpowers": true,
    "**/.firecrawl": true,
    "**/.serena": true,
    "**/.pytest_cache": true,
    "**/playwright/.cache": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/__pycache__": true,

    // Root tool configuration stays here for framework discovery, but does not
    // need to occupy the day-to-day Explorer surface.
    "/next.config.ts": true,
    "/next-env.d.ts": true,
    "/playwright*.ts": true,
    "/playwright*.mts": true,
    "/postcss.config.mjs": true,
    "/eslint.config.mjs": true,
    "/vitest.config.ts": true,
    "/vitest.setup.ts": true,
    "/tsconfig*.json": true,
    "next.config.ts": true,
    "next-env.d.ts": true,
    "playwright.config.ts": true,
    "playwright-ct.config.ts": true,
    "playwright.bots.config.ts": true,
    "playwright.bots.cloud.config.ts": true,
    "playwright.firebase.config.ts": true,
    "playwright.no-bypass.config.ts": true,
    "playwright.teach.config.ts": true,
    "playwright.corpus.config.ts": true,
    "playwright.boss-preview.config.mts": true,
    "postcss.config.mjs": true,
    "eslint.config.mjs": true,
    "vitest.config.ts": true,
    "vitest.setup.ts": true,
    "tsconfig.json": true
  },
  "explorer.excludeGitIgnore": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "README.md": "AGENTS.md, CLAUDE.md, GUARDRAILS.md, DECISIONS.md, LESSONS_LEARNED.md, PROGRESS.md, REPO_HEALTH.md, TESTING.md, MANUAL_LIVE_TEST.md",
    "package.json": "package-lock.json, .env.example, .env.local, .env.teachbot",
    "firebase.json": ".firebaserc, firestore.rules, firestore.indexes.json",
    "vercel.json": ".vercelignore",
    ".gitignore": ".gitattributes"
  },
  "git.autorefresh": false,
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/.next", "**/scripts/dt-harvest/state", "**/data"]
  }
}
