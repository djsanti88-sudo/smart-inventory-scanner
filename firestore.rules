rules_version = '2';

// Multi-tenant security for the Smart Inventory Scanner (Launch MVP Phase 1, Firebase).
// Business-scoped data lives in SUBCOLLECTIONS under /businesses/{businessId}/... so every rule derives
// the tenant from the PATH (businessId wildcard) - which works uniformly for get, list, create, update,
// and delete (no reliance on `resource`, which is null during list/query authorization). A user may only
// touch a business's data if they are a member with the required role; writing outside your business's
// path is impossible, so forged-businessId writes are blocked by construction. Membership docs are keyed
// `${businessId}_${uid}` so rules read them with a single exists()/get().

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function memberPath(bid) {
      return /databases/$(database)/documents/businessMembers/$(bid + '_' + uid());
    }
    function businessPath(bid) {
      return /databases/$(database)/documents/businesses/$(bid);
    }
    function isMember(bid) {
      return isSignedIn()
        && exists(businessPath(bid))
        && exists(memberPath(bid));
    }
    function roleOf(bid) { return get(memberPath(bid)).data.role; }
    function hasRole(bid, roles) { return isMember(bid) && (roleOf(bid) in roles); }
    // A business-scoped doc, if it carries a businessId field, must match its path (defense in depth).
    function bizFieldOk(bid) {
      return !('businessId' in request.resource.data) || request.resource.data.businessId == bid;
    }
    function isUnlockedSession(data) {
      return (!('locked' in data) || data.locked == false)
        && (!('lockedAt' in data) || data.lockedAt == null);
    }
    function sessionPath(bid, sid) {
      return /databases/$(database)/documents/businesses/$(bid)/countSessions/$(sid);
    }
    function counterOwnActiveSession(bid, sid) {
      return hasRole(bid, ['counter'])
        && exists(sessionPath(bid, sid))
        && get(sessionPath(bid, sid)).data.businessId == bid
        && get(sessionPath(bid, sid)).data.createdBy == uid()
        && get(sessionPath(bid, sid)).data.status == 'active'
        && isUnlockedSession(get(sessionPath(bid, sid)).data);
    }
    function counterProductDataOk(data, bid, productId) {
      return data.businessId == bid
        && data.id == productId
        && data.provisional == true
        && data.verified == false
        && data.status == 'active'
        && !('unitCost' in data)
        && (!('aliases' in data) || data.aliases.size() == 0)
        && (!('provenanceTier' in data) || data.provenanceTier == 'provisional')
        && (!('source' in data) || data.source == 'ai_openai')
        && (!('createdBy' in data) || data.createdBy == 'ai')
        && (!('updatedBy' in data) || data.updatedBy == 'ai')
        && (!('structuredBy' in data) || data.structuredBy != 'human');
    }
    function counterProductCreateOk(bid, productId) {
      return hasRole(bid, ['counter'])
        && counterProductDataOk(request.resource.data, bid, productId);
    }
    // Campaign #32 fix (P1b fix round 1): a counter's decode/settlement re-save of a product it created
    // (fresh idempotency key, same entity id) is an update, not a create. The BEFORE doc must already be
    // this counter's own provisional/unverified row (the same invariant the create rule enforces) - that
    // is the ownership proxy, since only a counter-authored row can satisfy counterProductDataOk.
    // Identity (businessId/id) is pinned. Content is now an EXPLICIT allowlist derived from the actual
    // SAVE_PRODUCT re-save payloads in firebaseSyncTarget.ts (trusted-exact settlement + the paired
    // archived-provisional write): decode/identity/settlement fields only. unitCost and aliases are
    // deliberately NEVER in the allowlist (panel MUST-FIX 1: no cost/price smuggling, no alias grafting) -
    // enforced twice, once implicitly (any diff key outside the allowlist denies the whole write) and once
    // explicitly for readability. verified/provisional MAY move true/false (ruling R1: the app is
    // client-only, trusted-exact settlement legitimately promotes a counter-owned provisional to
    // verified:true) - but only within this allowlist, and only once: after promotion the BEFORE-state
    // gate above (counterProductDataOk requires verified==false) can never fire again on this doc, so a
    // counter cannot touch it a second time. status may only move 'active' -> 'archived' (the
    // orphan-provisional-after-merge write), never back.
    function counterProductUpdateOk(bid, productId) {
      let before = resource.data;
      let after = request.resource.data;
      return hasRole(bid, ['counter'])
        && counterProductDataOk(before, bid, productId)
        && after.businessId == bid
        && after.id == productId
        && !('unitCost' in after)
        && after.get('aliases', []) == before.get('aliases', [])
        && (after.status == before.status || (before.status == 'active' && after.status == 'archived'))
        && after.diff(before).affectedKeys().hasOnly([
          'name', 'brand', 'category', 'specsShort', 'specsFull', 'primarySku', 'primaryBarcode',
          'gtin', 'upc', 'ean', 'source', 'confidence', 'verified', 'provisional', 'provenanceTier',
          'trustedExactCanonicalId', 'status', 'updatedAt', 'updatedBy'
        ]);
    }
    function validCounterSessionState() {
      return (
        request.resource.data.status == 'active'
        && request.resource.data.completedAt == null
      ) || (
        request.resource.data.status == 'completed'
        && request.resource.data.completedAt is string
      );
    }
    function counterSessionCreateOk(bid, sessionId) {
      return hasRole(bid, ['counter'])
        && request.resource.data.businessId == bid
        && request.resource.data.id == sessionId
        && request.resource.data.createdBy == uid()
        && request.resource.data.status == 'active'
        && request.resource.data.completedAt == null
        && isUnlockedSession(request.resource.data);
    }
    function counterSessionUpdateOk(bid, sessionId) {
      return hasRole(bid, ['counter'])
        && resource.data.businessId == bid
        && resource.data.id == sessionId
        && resource.data.createdBy == uid()
        && resource.data.status == 'active'
        && isUnlockedSession(resource.data)
        && request.resource.data.businessId == bid
        && request.resource.data.id == sessionId
        && request.resource.data.createdBy == uid()
        // Panel MUST-FIX 5: a direct `.startedAt` field access errors (denies non-deterministically)
        // rather than cleanly denying when a legacy/partial session doc lacks the key. `.get(key,
        // default)` makes a missing key on either side compare deterministically instead of erroring.
        && request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null)
        && isUnlockedSession(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'location',
          'status',
          'completedAt',
          'notes',
          'syncStatus',
          'deviceId',
          'updatedAt'
        ])
        && validCounterSessionState();
    }
    // Campaign #32 fix (P1b fix round 1): the same "fresh key, same entity id, own doc" re-save pattern
    // for scanEvents and unknownCodeReviews. Ownership proxy is counterOwnActiveSession on the BEFORE
    // doc's sessionId - the same helper the create rule uses - and tenancy/identity are pinned immutable
    // on both sides. Panel MUST-FIX 2: matchedProductId/rawCode/cleanCode are now ALSO pinned immutable
    // (in addition to businessId/id/sessionId/createdAt/quantityDelta), which kills the count-remap
    // forgery vector (a re-save cannot redirect a scan event's identity to a different product/code).
    // KNOWN TRADE-OFF (reported, not fixed here - out of this round's file scope): the markWrong-transfer
    // and trusted-exact-merge-to-a-different-existing-product flows legitimately repoint
    // ScanEvent.matchedProductId via this same SAVE_SCAN_EVENT re-save path (scanStore.ts ~L1093,
    // ~L1451). Pinning it here means those two flows, if performed under the `counter` role (not proven
    // role-gated to owner/admin in the UI), will newly deny with permission_denied instead of the count
    // forgery the panel found. See task-p1b-report.md for the flagged app-code/product decision.
    function counterScanEventUpdateOk(bid, eventId) {
      let before = resource.data;
      let after = request.resource.data;
      return hasRole(bid, ['counter'])
        && before.businessId == bid
        && before.id == eventId
        && counterOwnActiveSession(bid, before.sessionId)
        && after.businessId == bid
        && after.id == eventId
        && after.sessionId == before.sessionId
        && after.createdAt == before.createdAt
        && after.quantityDelta == before.quantityDelta
        && after.matchedProductId == before.matchedProductId
        && after.rawCode == before.rawCode
        && after.cleanCode == before.cleanCode
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'decodeStatus', 'reason', 'decodeNote', 'resolverStatus', 'matchType',
          'provenance', 'offCategory', 'suggestion', 'syncStatus', 'syncedAt'
        ]);
    }
    // Panel MUST-FIX 3: rawCode/cleanCode are pinned immutable (unlike ScanEvent's createdAt, they are
    // NOT touched by FirebaseSyncTarget's SAVE_UNKNOWN_SCAN write, so pinning them is safe). status is
    // restricted to exactly the shape the legit trusted-exact settlement flow produces (scanStore.ts
    // settledReview, ~L1464-1496) via counterUnknownResolutionOk below, closing the resolvedBy
    // impersonation vector.
    // NOTE (unchanged from prior round, still true): FirebaseSyncTarget.apply() stamps a fresh
    // serverTimestamp() into `createdAt` on EVERY unknownCodeReviews write (create and update alike), so
    // createdAt is NOT pinned here; pinning it would make every legitimate re-save fail, re-creating the
    // exact bug this fix resolves. Flagged as a reportable payload/rule mismatch in task-p1b-report.md.
    function counterUnknownResolutionOk(before, after) {
      return (
        after.status == before.status
        && after.get('resolvedBy', null) == before.get('resolvedBy', null)
        && after.get('resolutionAction', null) == before.get('resolutionAction', null)
        && after.get('resolvedAt', null) == before.get('resolvedAt', null)
        && after.get('exactCodeEvidenceVerifiedByApp', false) == before.get('exactCodeEvidenceVerifiedByApp', false)
      ) || (
        (before.status == 'open' || before.status == 'suggested')
        && after.status == 'resolved'
        && after.resolvedBy == 'system:trusted_exact'
        && after.resolutionAction == 'trusted_exact'
        && after.exactCodeEvidenceVerifiedByApp == true
      );
    }
    function counterUnknownUpdateOk(bid, reviewId) {
      let before = resource.data;
      let after = request.resource.data;
      return hasRole(bid, ['counter'])
        && before.businessId == bid
        && before.id == reviewId
        && counterOwnActiveSession(bid, before.sessionId)
        && after.businessId == bid
        && after.id == reviewId
        && after.sessionId == before.sessionId
        && after.rawCode == before.rawCode
        && after.cleanCode == before.cleanCode
        && counterUnknownResolutionOk(before, after)
        && after.diff(before).affectedKeys().hasOnly([
          'suggestedProductName', 'suggestedBrand', 'suggestedCategory', 'suggestedSpecsShort',
          'suggestedSpecsFull', 'suggestedPrimarySku', 'suggestedPrimaryBarcode', 'suggestedGtin',
          'suggestedUpc', 'suggestedEan', 'suggestedAliases', 'sourceUrls', 'verifiedFacts', 'guesses',
          'reason', 'decodeNote', 'providerName', 'confidence', 'hasSuggestion', 'decodeStatus',
          'evidenceStrength', 'exactCodeEvidenceVerifiedByApp', 'crossCheckDecision',
          'suggestedLinkProductId', 'status', 'resolvedAt', 'resolvedBy', 'resolutionAction',
          'syncStatus', 'idempotencyKey', 'createdAt'
        ]);
    }
    function markerFieldsOk(bid) {
      return request.resource.data.keys().hasAll([
          'businessId',
          'entityType',
          'entityId',
          'sessionId',
          'targetId',
          'operation',
          'scanEventId',
          'payloadHash',
          'at'
        ])
        && request.resource.data.keys().hasOnly([
          'businessId',
          'entityType',
          'entityId',
          'sessionId',
          'targetId',
          'operation',
          'scanEventId',
          'payloadHash',
          'at'
        ])
        && request.resource.data.businessId == bid
        && request.resource.data.payloadHash is string
        && request.resource.data.at == request.time;
    }
    // Historical review fix: this marker check used to re-require the POST-write
    // product to still satisfy counterProductDataOk (verified==false), but legit trusted-exact
    // settlement writes verified:true in the SAME transaction as this marker create - transactions are
    // atomic, so that made the WHOLE settlement fail, not just narrow a field. Authorization for the
    // products/{id} write itself is the collection-level rule's job (counterProductCreateOk on create;
    // counterProductUpdateOk's BEFORE-state + diff-allowlist gate on update) - this marker only needs to
    // confirm the marker's own bookkeeping (which product, which transaction) is self-consistent, not
    // re-derive the full authorization a second time against a shape that no longer applies post-update.
    function counterProductMarkerOk(bid) {
      let marker = request.resource.data;
      let target = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/products/$(marker.targetId)
      ).data;
      return marker.operation == 'SAVE_PRODUCT'
        && marker.entityType == 'Product'
        && marker.entityId == marker.targetId
        && marker.scanEventId == null
        && target.businessId == bid
        && target.id == marker.entityId
        && target.updatedAt == request.time;
    }
    function counterSessionMarkerOk(bid) {
      let marker = request.resource.data;
      let target = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/countSessions/$(marker.targetId)
      ).data;
      return marker.operation == 'SAVE_SESSION'
        && marker.entityType == 'CountSession'
        && marker.entityId == marker.targetId
        && marker.sessionId == marker.entityId
        && marker.scanEventId == null
        && target.id == marker.entityId
        && target.businessId == bid
        && target.createdBy == uid()
        && target.updatedAt == request.time
        && isUnlockedSession(target)
        && (
          (target.status == 'active' && target.completedAt == null)
          || (target.status == 'completed' && target.completedAt is string)
        );
    }
    function counterScanEventMarkerOk(bid) {
      let marker = request.resource.data;
      let target = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/scanEvents/$(marker.targetId)
      ).data;
      return marker.operation == 'SAVE_SCAN_EVENT'
        && marker.entityType == 'ScanEvent'
        && marker.entityId == marker.targetId
        && marker.scanEventId == marker.entityId
        && target.id == marker.entityId
        && target.businessId == bid
        && target.sessionId == marker.sessionId
        && target.createdAt is string
        && target.syncedAt == request.time
        && counterOwnActiveSession(bid, marker.sessionId);
    }
    function counterUnknownMarkerOk(bid) {
      let marker = request.resource.data;
      let target = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/unknownCodeReviews/$(marker.targetId)
      ).data;
      return marker.operation == 'SAVE_UNKNOWN_SCAN'
        && marker.entityType == 'UnknownCodeReview'
        && marker.entityId == marker.targetId
        && target.id == marker.entityId
        && target.businessId == bid
        && target.sessionId == marker.sessionId
        && target.createdAt == request.time
        && counterOwnActiveSession(bid, marker.sessionId);
    }
    function appliedKeyPath(bid, key) {
      return /databases/$(database)/documents/businesses/$(bid)/_appliedKeys/$(key);
    }
    function counterCountMarkerOk(bid, key) {
      let marker = request.resource.data;
      let target = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/inventoryCounts/$(marker.targetId)
      ).data;
      let scanEvent = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/scanEvents/$(marker.scanEventId)
      ).data;
      return marker.operation == 'INCREMENT_COUNT'
        && marker.entityType == 'InventoryCount'
        && target.appliedKeyId == key
        && marker.targetId == (marker.sessionId + '_' + target.productId)
        && target.businessId == bid
        && target.countSessionId == marker.sessionId
        && target.updatedAt == request.time
        && marker.scanEventId == target.lastScanEventId
        && scanEvent.id == marker.scanEventId
        && scanEvent.businessId == bid
        && scanEvent.sessionId == marker.sessionId
        && scanEvent.matchedProductId == target.productId
        && scanEvent.quantityDelta == 1
        && counterOwnActiveSession(bid, marker.sessionId);
    }
    function counterAppliedKeyCreateOk(bid, key) {
      return hasRole(bid, ['counter'])
        && markerFieldsOk(bid)
        && (
          counterProductMarkerOk(bid)
          || counterSessionMarkerOk(bid)
          || counterScanEventMarkerOk(bid)
          || counterUnknownMarkerOk(bid)
          || counterCountMarkerOk(bid, key)
        );
    }
    function counterCountEnvelopeOk(bid, countId) {
      let target = request.resource.data;
      let marker = getAfter(appliedKeyPath(bid, target.appliedKeyId)).data;
      let scanEvent = getAfter(
        /databases/$(database)/documents/businesses/$(bid)/scanEvents/$(target.lastScanEventId)
      ).data;
      return target.keys().hasAll([
          'businessId',
          'countSessionId',
          'productId',
          'countedQuantity',
          'scanEventIds',
          'appliedKeyId',
          'lastQuantityDelta',
          'lastScanEventId',
          'updatedAt'
        ])
        && target.appliedKeyId is string
        && target.lastQuantityDelta is int
        && target.lastScanEventId is string
        && target.countedQuantity is int
        && target.scanEventIds is list
        && target.businessId == bid
        && countId == (target.countSessionId + '_' + target.productId)
        && target.updatedAt == request.time
        && marker.businessId == bid
        && marker.entityType == 'InventoryCount'
        && marker.operation == 'INCREMENT_COUNT'
        && marker.targetId == countId
        && marker.sessionId == target.countSessionId
        && marker.scanEventId == target.lastScanEventId
        && marker.payloadHash is string
        && marker.at == request.time
        && scanEvent.id == target.lastScanEventId
        && scanEvent.businessId == bid
        && scanEvent.sessionId == target.countSessionId
        && scanEvent.matchedProductId == target.productId
        && scanEvent.quantityDelta == 1
        && counterOwnActiveSession(bid, target.countSessionId);
    }
    function counterCountCreateOk(bid, countId) {
      let target = request.resource.data;
      return hasRole(bid, ['counter'])
        && counterCountEnvelopeOk(bid, countId)
        && target.lastQuantityDelta == 1
        && target.countedQuantity == target.lastQuantityDelta
        && target.scanEventIds == [target.lastScanEventId];
    }
    function counterCountUpdateOk(bid, countId) {
      let before = resource.data;
      let after = request.resource.data;
      let eventAlreadyCounted = after.lastScanEventId in before.scanEventIds;
      return hasRole(bid, ['counter'])
        && counterCountEnvelopeOk(bid, countId)
        && before.businessId == bid
        && after.businessId == before.businessId
        && after.countSessionId == before.countSessionId
        && after.productId == before.productId
        && after.diff(before).affectedKeys().hasOnly([
          'countedQuantity',
          'scanEventIds',
          'appliedKeyId',
          'lastQuantityDelta',
          'lastScanEventId',
          'updatedAt'
        ])
        && (
          (
            eventAlreadyCounted
            && after.lastQuantityDelta == 0
            && after.countedQuantity == before.countedQuantity
            && after.scanEventIds == before.scanEventIds
          )
          || (
            !eventAlreadyCounted
            && after.lastQuantityDelta == 1
            && after.countedQuantity == before.countedQuantity + after.lastQuantityDelta
            && after.scanEventIds == before.scanEventIds.concat([after.lastScanEventId])
          )
        );
    }

    // ----- user profiles: each user only their own (doc id = uid) -----
    match /userProfiles/{userId} {
      allow read: if isSignedIn() && userId == uid();
      allow create: if isSignedIn()
        && userId == uid()
        && !request.resource.data.keys().hasAny(['defaultBusinessId']);
      allow update: if isSignedIn()
        && userId == uid()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['defaultBusinessId']);
      allow delete: if false;
    }

    // Provisioning request pointers are written only by the authenticated Admin SDK route.
    match /businessProvisioningRequests/{requestId} {
      allow read, write: if false;
    }

    // ----- business memberships (doc id = `${businessId}_${userId}`) -----
    function validMemberRole(role) {
      return role in ['owner', 'admin', 'counter', 'viewer'];
    }
    function validMemberIdentity(memberId, data) {
      return data.businessId is string
        && data.userId is string
        && validMemberRole(data.role)
        && memberId == (data.businessId + '_' + data.userId);
    }
    match /businessMembers/{memberId} {
      allow read: if isSignedIn() && resource != null
        && (resource.data.userId == uid() || isMember(resource.data.businessId));
      allow create: if isSignedIn()
        && validMemberIdentity(memberId, request.resource.data)
        && (
          hasRole(request.resource.data.businessId, ['owner'])
          || (
            hasRole(request.resource.data.businessId, ['admin'])
            && request.resource.data.role != 'owner'
          )
        );
      // Owner memberships are server-managed once created. This prevents an admin (or another owner)
      // from promoting, demoting, or deleting the final owner through a client write.
      allow update: if validMemberIdentity(memberId, resource.data)
        && validMemberIdentity(memberId, request.resource.data)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.userId == resource.data.userId
        && resource.data.role != 'owner'
        && request.resource.data.role != 'owner'
        && hasRole(resource.data.businessId, ['owner', 'admin']);
      allow delete: if validMemberIdentity(memberId, resource.data)
        && resource.data.role != 'owner'
        && hasRole(resource.data.businessId, ['owner', 'admin']);
    }

    // ----- businesses + their scoped subcollections -----
    match /businesses/{bid} {
      allow read: if isMember(bid);
      allow create: if false;
      allow update: if hasRole(bid, ['owner', 'admin'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);
      allow delete: if hasRole(bid, ['owner']);

      // Products are managed by owner/admin. Counters may only create an explicitly unverified,
      // provisional row for immediate counting; they cannot promote or edit any product.
      match /products/{id} {
        allow read: if isMember(bid);
        allow create: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterProductCreateOk(bid, id);
        allow update: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterProductUpdateOk(bid, id);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }
      // Aliases/settings/shopOverrides remain owner/admin-only writes.
      match /aliases/{id} {
        allow read: if isMember(bid);
        allow create, update: if hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }
      match /settings/{id} {
        allow read: if isMember(bid);
        allow create, update: if hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid);
        allow delete: if false;
      }
      match /shopOverrides/{id} {
        allow read: if isMember(bid);
        allow create, update: if hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }

      // Counters may start their own active session and update it only while its stored state remains
      // active (including the one-way active -> completed transition). They cannot take ownership,
      // reopen/edit completed sessions, touch another counter's session, or use owner lock controls.
      match /countSessions/{id} {
        allow read: if isMember(bid);
        allow create: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterSessionCreateOk(bid, id);
        allow update: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterSessionUpdateOk(bid, id);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }

      // scanEvents: counters (and up) create; immutable to non-admins.
      match /scanEvents/{id} {
        allow read: if isMember(bid);
        allow create: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || (
          request.resource.data.businessId == bid
          && request.resource.data.id == id
          && counterOwnActiveSession(bid, request.resource.data.sessionId)
        );
        allow update: if hasRole(bid, ['owner', 'admin']) || counterScanEventUpdateOk(bid, id);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }

      // inventoryCounts: counters write only inside their own active, unlocked session.
      match /inventoryCounts/{id} {
        allow read: if isMember(bid);
        allow create: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterCountCreateOk(bid, id);
        allow update: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterCountUpdateOk(bid, id);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }

      // unknownCodeReviews: counters create; owner/admin review.
      match /unknownCodeReviews/{id} {
        allow read: if isMember(bid);
        allow create: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || (
          request.resource.data.businessId == bid
          && request.resource.data.id == id
          && counterOwnActiveSession(bid, request.resource.data.sessionId)
        );
        allow update: if (
          hasRole(bid, ['owner', 'admin']) && bizFieldOk(bid)
        ) || counterUnknownUpdateOk(bid, id);
        allow delete: if hasRole(bid, ['owner', 'admin']);
      }

      // auditLog: append-only. Any member may create; nobody may edit/delete; owner/admin read.
      match /auditLog/{id} {
        allow read: if hasRole(bid, ['owner', 'admin']);
        allow create: if isMember(bid) && bizFieldOk(bid);
        allow update, delete: if false;
      }

      // _appliedKeys: idempotency ledger written by FirebaseSyncTarget transactions. Append-only; a
      // member who can write scans/counts may create a key; never updated/deleted.
      match /_appliedKeys/{key} {
        allow read: if isMember(bid);
        allow create: if hasRole(bid, ['owner', 'admin']) || counterAppliedKeyCreateOk(bid, key);
        allow update, delete: if false;
      }
    }

    // ----- shared global catalog ("the brain"): PUBLIC read (sanitized, non-private reference data only:
    // barcode/brand/model/size — no businessId/prices/customer data). Writes are SERVER-ONLY (Admin SDK).
    // Public read lets the local/no-login app resolve scans from the cloud catalog without writing anything. -----
    match /catalogEntries/{id} {
      allow read: if true;
      allow write: if false;

      // Moderation trail (disputedBy/auditLog): contains raw businessId + free-text reasons.
      // NEVER public. Server (Admin SDK) writes only; no client read path exists or should exist.
      // Firestore rules cannot field-filter a `get` on the parent doc above, so these sensitive
      // fields must live in this locked subcollection instead of on the public parent doc.
      match /moderation/{docId} {
        allow read, write: if false;
      }
    }

    // ----- SEPARATE retail catalog (Open Food Facts + enrichment): same PUBLIC-read, server-only-write
    // model as catalogEntries. Distinct collection so retail data is never mixed with tires. -----
    match /retailCatalogEntries/{id} {
      allow read: if true;
      allow write: if false;

      // Same latent-risk closure as catalogEntries/moderation above - no dispute path targets this
      // collection today, but the shape (public parent doc) is identical, so close it now too.
      match /moderation/{docId} {
        allow read, write: if false;
      }
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
