# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
# keep e2e/proof/ screenshots (they are deliberate proof artifacts)

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase emulator artifacts (transient)
*-debug.log
.firebase/
firebase-export-*/

# service-account keys / secrets — NEVER commit
sa-key.json
sa-key*.json
service-account*.json
service_account*.json
serviceAccount*.json
*firebase-adminsdk*.json
*.serviceaccount.json
gcloud-*.json

# Large retail harvest data (downloaded/regenerable - never commit)
data/retail-knowledge/*.jsonl
data/retail-knowledge/retail_corpus.csv
data/retail-knowledge/outputs/
*.csv.gz

# Generated QA / Playwright result JSON can capture env values including API keys. Never track.
# (A real Anthropic + SerpAPI key leaked through these once. Keep them untracked going forward.)
playwright-results.json
cloud-playwright-results.json
reports/**/playwright-results.json
reports/**/cloud-playwright-results.json

# Runtime daily spend-cap counter for /api/ai-lookup (local-first state, regenerated)
.ai-lookup-usage.json
.gpt-ladder-usage.json
# Persistent decode cache (L2) file fallback when Turso is not configured - regenerated
.decode-cache.json
.env*.local

# Python bytecode + compile caches (tire-knowledge pipeline scripts) - regenerated
*.pyc
__pycache__/

# Run logs + pipeline locks - regenerated, never source
*.log
data/**/*.lock

# Nested auto-generated Playwright HTML report (root /playwright-report already ignored above)
reports/**/playwright-report/

# Generated SQLite knowledge DB (uncompressed is gitignored; .gz is committed via LFS)
src/server/knowledge.generated.db
src/server/knowledge.generated.db-wal
src/server/knowledge.generated.db-shm

# Agent/session scratch (Playwright MCP snapshots + superpowers tooling state)
.playwright-mcp/
.superpowers/
knowledge.generated.db.gz
scripts/barcode-harvester/output/*.csv

# --- Phase 4 candidate hygiene: generated bot/QA reports, proof screenshots, tool scratch ---
# Regenerated by the QA bots / Playwright; untracked so Source Control shows real app changes.
# (Files stay ON DISK - this is `git rm --cached`, never a disk delete.)
/reports/
/e2e/proof/
/scratchpad/

# Turso/SQLite WAL artifacts (local auth session files)
auth
auth-wal

# Discount Tire harvest: resumable crawl state (urls/done/telemetry) - too big
# for git and regenerated by discover.mjs / run-batch.mjs.
scripts/dt-harvest/state/

# dt-harvest corpus apply backups (local only)
src/server/tire-knowledge/tireKnowledge.generated.json.bak-*

# Root artifact sweep (Task 1.2, 2026-07-12): root-level proof PNGs and firestore emulator log
# are regenerated/transient; archived copies live in docs/archive/proof-images/.
/*.png
/firestore-debug.log

# Stray untracked scratch files archived on disk only (never git-tracked) - keep the
# directory out of git so future strays land here without needing an explicit rm --cached.
docs/archive/strays/

# Task 1.3 (2026-07-12): archived tmp-* probe/benchmark artifacts from scripts/. Files git-mv'd
# here stay tracked regardless of this rule; this only keeps the (majority) untracked ones from
# re-entering git status noise.
scripts/archive-tmp-2026-07/

# Task 20 (2026-07-15): decode-cache backup/restore dumps (pay-once durability) - local ops
# artifacts containing paid-decode payloads, never source; regenerated by
# scripts/decode-cache-backup.mjs --dump.
/backups/
