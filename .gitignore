# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
# playwright-cli terminal-session scratch: console-*.log is caught by *.log below, but the
# page-*.yml snapshots are not - ignore the whole run-artifact dir (files stay on disk).
/.playwright-cli/
# Playwright component-testing (CT) Vite build cache - regenerated, never source.
/playwright/.cache/
# Playwright handoff proof screenshots (artifacts from a specific teach-bot run) - the .md
# handoff notes in docs/playwright/handoffs/ are kept; only the image dirs are ignored.
docs/playwright/handoffs/proof*/
# keep e2e/proof/ screenshots (they are deliberate proof artifacts)

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase emulator artifacts (transient)
*-debug.log
.firebase/
firebase-export-*/

# service-account keys / secrets — NEVER commit
sa-key.json
sa-key*.json
service-account*.json
service_account*.json
serviceAccount*.json
*firebase-adminsdk*.json
*.serviceaccount.json
gcloud-*.json

# Large retail harvest data (downloaded/regenerable - never commit)
data/retail-knowledge/*.jsonl
data/retail-knowledge/retail_corpus.csv
data/retail-knowledge/outputs/
*.csv.gz

# Generated QA / Playwright result JSON can capture env values including API keys. Never track.
# (A real Anthropic + SerpAPI key leaked through these once. Keep them untracked going forward.)
playwright-results.json
cloud-playwright-results.json
reports/**/playwright-results.json
reports/**/cloud-playwright-results.json

# Runtime daily spend-cap counter for /api/ai-lookup (local-first state, regenerated)
.ai-lookup-usage.json
.gpt-ladder-usage.json
# Persistent decode cache (L2) file fallback when Turso is not configured - regenerated
.decode-cache.json
.env*.local

# Python bytecode + compile caches (tire-knowledge pipeline scripts) - regenerated
*.pyc
__pycache__/

# Run logs + pipeline locks - regenerated, never source
*.log
data/**/*.lock

# Fable 5 generated state and latest-review pointer
/.fable5/
/docs/reviews/LATEST.json

# Nested auto-generated Playwright HTML report (root /playwright-report already ignored above)
reports/**/playwright-report/

# Generated SQLite knowledge DB. NEITHER the .db NOR the .gz is committed.
# The comment here used to claim the .gz was "committed via LFS" - that was true only briefly.
# `dae61ed8 perf: commit pre-built SQLite .gz via LFS` was undone by
# `decc1ace revert: remove .gz from git (too large for Hobby function bundle)`, and `git ls-files`
# confirms zero tracked. Consequence worth knowing before reasoning about production: because the
# .gz does not ship in the function bundle, getKnowledgeDb() returns null on Vercel and every
# corpus lookup falls through to Turso. Both files are built locally by `npm run build:knowledge-db`.
src/server/knowledge.generated.db
knowledge.generated.db.gz
src/server/knowledge.generated.db-wal
src/server/knowledge.generated.db-shm
# Generation manifest (DT2-1, 2026-08-13): sha256 fingerprints of the paired .db/.db.gz outputs,
# regenerated on every build alongside them -- never committed, same as the DB itself.
src/server/knowledge.generated.manifest.json

# Agent/session scratch (Playwright MCP snapshots + superpowers tooling state)
.playwright-mcp/
.superpowers/
scripts/barcode-harvester/output/*.csv

# --- Phase 4 candidate hygiene: generated bot/QA reports, proof screenshots, tool scratch ---
# Regenerated by the QA bots / Playwright; untracked so Source Control shows real app changes.
# (Files stay ON DISK - this is `git rm --cached`, never a disk delete.)
/reports/
/e2e/proof/
/scratchpad/

# Turso/SQLite WAL artifacts (local auth session files) - root-anchored so the
# bare name never swallows real source dirs like src/services/auth/
/auth
/auth-wal

# Discount Tire harvest: resumable crawl state (urls/done/telemetry) - too big
# for git and regenerated by discover.mjs / run-batch.mjs.
scripts/dt-harvest/state/

# dt-harvest corpus apply backups (local only)
src/server/tire-knowledge/tireKnowledge.generated.json.bak-*

# Root artifact sweep (Task 1.2, 2026-07-12): root-level proof PNGs and firestore emulator log
# are regenerated/transient; archived copies live in docs/archive/proof-images/.
/*.png
/firestore-debug.log

# Stray untracked scratch files archived on disk only (never git-tracked) - keep the
# directory out of git so future strays land here without needing an explicit rm --cached.
docs/archive/strays/

# Task 1.3 (2026-07-12): archived tmp-* probe/benchmark artifacts from scripts/. Files git-mv'd
# here stay tracked regardless of this rule; this only keeps the (majority) untracked ones from
# re-entering git status noise.
scripts/archive-tmp-2026-07/

# Task 20 (2026-07-15): decode-cache backup/restore dumps (pay-once durability) - local ops
# artifacts containing paid-decode payloads, never source; regenerated by
# scripts/decode-cache-backup.mjs --dump.
/backups/

# Session strays (T19, 2026-07-15): serena MCP state; Polo's Point mockups deferred by owner
# (files stay on disk, untracked); stray eval-results scratch json.
.serena/
mockups/
scripts/polish-eval-results.json

# Sweep E (2026-08-12): completed July fetchv2/tmp/proof-rung probe + benchmark output data,
# git rm --cached out of scripts/ (kept on disk). Mirrors the scripts/archive-tmp-2026-07/
# precedent above: this only keeps this class of artifact out of git status noise going
# forward, it does not retroactively untrack anything not already removed from the index.
scripts/fetchv2-*.json
scripts/tmp-*.json
scripts/tmp-*.log
scripts/proof-rung-*.json
scripts/proof-full-ladder-*.json
scripts/proof-ladder-report.md
scripts/dryrun-candidates-*.json
scripts/gpt-ladder-live-results.json

# Task B1 (2026-07-15): generated on-hand backfill candidate worklist - regenerated by
# scripts/pilot-backfill-worklist.mjs, never source (review-gated CANDIDATE output, not an
# attachment; owner review happens against the freshly generated file each run).
docs/pilot/point-s-backfill-worklist.csv
.ladder-kv.json

.vercel
.env*
.playwright-cli/

# User-authorized, isolated KKM catalog snapshot. It must never enter the app corpus or Git.
/data/kkm-catalog/kkm.sqlite
/data/kkm-catalog/kkm.sqlite-shm
/data/kkm-catalog/kkm.sqlite-wal

# Source-isolated distributor catalog snapshots; never app corpus input or Git artifacts.
/data/atd-catalog/atd.sqlite
/data/atd-catalog/atd.sqlite-shm
/data/atd-catalog/atd.sqlite-wal
/data/ntw-catalog/ntw.sqlite
/data/ntw-catalog/ntw.sqlite-shm
/data/ntw-catalog/ntw.sqlite-wal

# Teach Bot (2026-07-22): live-app learning test harness.
# Run artifacts (screenshots/traces/video/reports/manifests) are large + may reference
# per-run synthetic accounts; regenerated every run, never source. Keep the dir via .gitkeep.
testing/artifacts/*
!testing/artifacts/.gitkeep

# Session scratch / local run artifacts (never source)
.tmp/
outputs/
.codex/environments/
.claude/worktrees/

# Docs consolidation (2026-07-29): tire-knowledge pipeline task/run reports and export
# manifests are generated output, never source; untracked via git rm --cached, files stay
# on disk. mine-report.md / siblings-report.md are designed committed generator outputs
# and are NOT covered by this pattern (different directory).
data/tire-knowledge/scripts/tests/task-*-report.md
data/tire-knowledge/run-log.md
data/tire-knowledge/exports/**/MANIFEST.md
.pytest_cache/

# Tree triage (2026-08-12): local scratch that should never be tracked.
# `db` / `db-wal` are zero-byte SQLite artifacts a script created in the repo root
# on 2026-08-10 (bad path arg); the real corpus DB is src/server/knowledge.generated.db.
# Leading slash is REQUIRED: a bare `db` matches ANY path component named db, which
# silently ignored the entire src/services/db/ directory (caught 2026-08-12 when a
# `git add src/services/db/repositories.ts` was refused). Anchor to the repo root.
/db
/db-wal
# One-off barcode fixtures from the CANELO stress campaigns (referenced only by plan docs).
test-2000-barcodes.txt
tire-barcodes-1000.txt
# Local review-tool state.
.claude/.deep-review-radar.json

# Large analysis ledgers are local outputs, never committed (2026-08-19)
docs/analysis/**/*.jsonl.gz

# Regenerable tire-knowledge snapshots/viewers (data/tire-knowledge/scripts/*.py rebuild them); removed from git 2026-08-19
data/tire-knowledge/outputs/backup_corpus_*.csv
data/tire-knowledge/exports/
data/tire-knowledge/tire_corpus_view.html
