# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
# keep e2e/proof/ screenshots (they are deliberate proof artifacts)

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase emulator artifacts (transient)
*-debug.log
.firebase/
firebase-export-*/

# service-account keys / secrets — NEVER commit
sa-key.json
sa-key*.json
service-account*.json
service_account*.json
serviceAccount*.json
*firebase-adminsdk*.json
*.serviceaccount.json
gcloud-*.json
